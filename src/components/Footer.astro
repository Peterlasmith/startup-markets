---
import { feedUrl, podcastPagePath } from '../lib/podcast';

const podcastHref = podcastPagePath();
const feed = feedUrl();
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <p>Weekly synthesis for a Monday read. America/Denver.</p>
    <p>
      <a href={podcastHref}>Podcast</a>
      <span aria-hidden="true"> · </span>
      <a href={feed}>RSS</a>
      <span aria-hidden="true"> · </span>
      <a href="https://github.com/Peterlasmith/startup-markets">Source on GitHub</a>
    </p>
  </div>
</footer>
