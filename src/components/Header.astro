---
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const aboutHref = `${base}about/`;
const podcastHref = `${base}podcast/`;
const onArchive = path === base;
const onAbout = path === aboutHref;
const onPodcast = path === podcastHref;
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="wordmark" href={base}>
      <span class="mark" aria-hidden="true"></span>
      <span class="wordmark-text">
        <span class="wordmark-name">Start Up Markets</span>
        <span class="wordmark-sub">Bleeding-Edge Markets</span>
      </span>
    </a>
    <nav class="site-nav" aria-label="Primary">
      <a href={base} aria-current={onArchive ? 'page' : undefined}>Archive</a>
      <a href={podcastHref} aria-current={onPodcast ? 'page' : undefined}>Podcast</a>
      <a href={aboutHref} aria-current={onAbout ? 'page' : undefined}>About</a>
    </nav>
  </div>
</header>
