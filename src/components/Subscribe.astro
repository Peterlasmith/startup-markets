---
import { feedUrl, podcastPagePath } from '../lib/podcast';

interface Props {
  showDirectory?: boolean;
}

const { showDirectory = true } = Astro.props;
const feed = feedUrl();
const podcastHref = podcastPagePath();
---

<section class="subscribe" aria-labelledby="podcast-subscribe" data-feed>
  <div>
    <p class="eyebrow">Subscribe</p>
    <h2 id="podcast-subscribe">Listen to the week.</h2>
    <p>
      Audio companion to the written brief. Any podcast app can subscribe via RSS — paste the feed
      into Apple Podcasts, Overcast, Pocket Casts, or another app.
    </p>
  </div>
  <div class="feed-field">
    <p id="podcast-feed-label">Feed URL</p>
    <div class="feed-row">
      <p id="podcast-feed-url" class="feed-url" data-feed-value tabindex="0" aria-labelledby="podcast-feed-label">
        {feed}
      </p>
      <button type="button" data-copy-feed>Copy</button>
    </div>
    <p class="feed-links">
      <a href={feed}>podcast.xml</a>
      {
        showDirectory && (
          <>
            <span aria-hidden="true"> · </span>
            <a href={podcastHref}>All episodes</a>
          </>
        )
      }
    </p>
  </div>
</section>

<script>
  const roots = document.querySelectorAll('[data-feed]');
  for (const root of roots) {
    const button = root.querySelector('[data-copy-feed]');
    const field = root.querySelector('[data-feed-value]');
    if (!(button instanceof HTMLButtonElement) || !(field instanceof HTMLElement)) continue;

    const selectField = () => {
      const selection = window.getSelection();
      if (!selection) return;
      const range = document.createRange();
      range.selectNodeContents(field);
      selection.removeAllRanges();
      selection.addRange(range);
    };

    field.addEventListener('focus', selectField);

    button.addEventListener('click', async () => {
      const value = field.textContent?.trim() ?? '';
      try {
        await navigator.clipboard.writeText(value);
      } catch {
        field.focus();
        selectField();
        return;
      }
      const previous = button.textContent;
      button.textContent = 'Copied';
      window.setTimeout(() => {
        button.textContent = previous;
      }, 1600);
    });
  }
</script>
