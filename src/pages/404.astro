---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Base title="Not found" description="That page is not in the Start Up Markets archive.">
  <Header />
  <main id="content" class="wrap page">
    <p class="eyebrow">404</p>
    <h1>Not in the archive.</h1>
    <p class="lede">That page isn’t here. The briefs are on the archive.</p>
    <p><a class="text-link" href={import.meta.env.BASE_URL}>Back to the archive</a></p>
  </main>
  <Footer />
</Base>
